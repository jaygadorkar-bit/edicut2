{
  "name": "edicut-workspace",
  "private": true,
  "devDependencies": {
    "@types/node": "^20.17.6",
    "eslint": "^9.15.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.5"
  },
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --filter @edicut/web dev",
    "dev:node-api": "pnpm --filter @edicut/node-api dev",
    "build": "pnpm --filter @edicut/shared --filter @edicut/db --filter @edicut/web --filter @edicut/node-api build",
    "typecheck": "pnpm --filter @edicut/shared --filter @edicut/db --filter @edicut/web --filter @edicut/node-api typecheck",
    "health": "node scripts/health-check-new-stack.mjs",
    "db:typecheck": "pnpm --filter @edicut/db typecheck",
    "db:generate": "pnpm --filter @edicut/db db:generate",
    "db:push": "pnpm --filter @edicut/db db:push",
    "db:seed": "pnpm --filter @edicut/db db:seed"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "dotenv": "^16.6.1",
    "postgres": "^3.4.9"
  }
}
