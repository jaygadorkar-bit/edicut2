nalytics-region="navigation" class="neo-site-header sticky relative top-0 z-50 w-full border-b px-4 transition-all duration-300 sm:px-6"><div class="relative mx-auto flex h-16 max-w-7xl items-center justify-between gap-3 sm:h-[72px] sm:gap-4"><a aria-label="EdiCut home" class="transition-opacity hover:opacity-80" href="/" data-discover="true"><img src="/icons/edicut-logo.svg" alt="EdiCut" width="1162" height="506" class="h-9 sm:h-12 w-auto"/></a><nav aria-label="Main navigation" class="neo-header-nav hidden items-center gap-0.5 rounded-full border p-1 backdrop-blur-md lg:absolute lg:left-1/2 lg:flex lg:-translate-x-1/2"><a class="neo-header-link type-control rounded-full px-4 py-2 transition-all duration-200 hover:text-foreground " href="/" data-discover="true">Home</a><a class="neo-header-link type-control rounded-full px-4 py-2 transition-all duration-200 hover:text-foreground " href="/pricing" data-discover="true">Pricing</a><a class="neo-header-link type-control rounded-full px-4 py-2 transition-all duration-200 hover:text-foreground " href="/portfolio" data-discover="true">Portfolio</a><a class="neo-header-link type-control rounded-full px-4 py-2 transition-all duration-200 hover:text-foreground " href="/contact" data-discover="true">Contact</a></nav><div class="hidden items-center gap-3 lg:flex"><a class="neo-button neo-button--primary neo-button--compact neo-header-sign-in uppercase tracking-[0.12em]" href="/signin?mode=signin&amp;redirectTo=%2Fdashboard" data-discover="true"><span class="flex h-5 w-5 items-center justify-center rounded-full bg-black/5 text-current transition-colors"><span class="material-symbols-outlined text-[13px] text-current">person</span></span>Sign in</a></div><button type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="site-mobile-navigation-drawer" class="neo-header-menu flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border transition lg:hidden"><span class="material-symbols-outlined text-[22px]">menu</span></button></div></header><div aria-hidden="true" inert="" class="neo-header-drawer-overlay fixed inset-0 z-[100] overflow-hidden lg:hidden pointer-events-none"><div class="absolute inset-0 bg-slate-950/25 backdrop-blur-[2px] transition-opacity duration-300 opacity-0"></div><div id="site-mobile-navigation-drawer" role="dialog" aria-label="Mobile navigation" aria-hidden="true" class="neo-header-drawer absolute right-0 top-0 z-10 flex h-full w-[min(88vw,380px)] flex-col border-l shadow-2xl backdrop-blur-xl transition-transform duration-300 ease-out translate-x-full"><div class="neo-header-drawer-head flex h-16 shrink-0 items-center justify-end border-b px-5 sm:h-[72px] sm:px-6"><button type="button" aria-label="Close navigation" class="neo-header-menu flex h-10 w-10 items-center justify-center rounded-xl border transition"><span class="material-symbols-outlined text-[22px]">close</span></button></div><div class="flex flex-1 flex-col gap-2 overflow-y-auto p-5 sm:p-6"><p class="px-2 pb-2 text-[10px] font-black uppercase tracking-[0.18em] text-gray-400">Explore EdiCut</p><a class="neo-header-link type-menu flex min-h-12 items-center justify-between rounded-xl px-4 py-3 transition-colors hover:bg-black/5 " href="/" data-discover="true">Home<span class="material-symbols-outlined text-[18px] opacity-50">arrow_forward</span></a><a class="neo-header-link type-menu flex min-h-12 items-center justify-between rounded-xl px-4 py-3 transition-colors hover:bg-black/5 " href="/pricing" data-discover="true">Pricing<span class="material-symbols-outlined text-[18px] opacity-50">arrow_forward</span></a><a class="neo-header-link type-menu flex min-h-12 items-center justify-between rounded-xl px-4 py-3 transition-colors hover:bg-black/5 " href="/portfolio" data-discover="true">Portfolio<span class="material-symbols-outlined text-[18px] opacity-50">arrow_forward</span></a><a class="neo-header-link type-menu flex min-h-12 items-center justify-between rounded-xl px-4 py-3 transition-colors hover:bg-black/5 " href="/contact" data-discover="true">Contact<span class="material-symbols-outlined text-[18px] opacity-50">arrow_forward</span></a></div><div class="border-t border-black/5 p-5 sm:p-6"><div class="neo-mobile-support sm:hidden"><button type="button" aria-expanded="false" aria-controls="_R_7mcj5_" class="neo-button neo-button--primary neo-mobile-support-trigger w-full justify-center uppercase tracking-[0.14em]"><span class="material-symbols-outlined text-[19px]" aria-hidden="true">chat_bubble_outline</span>Chat with us<span class="material-symbols-outlined text-[18px]" aria-hidden="true">expand_less</span></button><div id="_R_7mcj5_" hidden="" class="neo-mobile-support-card rounded-2xl p-2"><a href="https://wa.me/8801625957738?text=Hi%20EdiCut%2C%20I&#x27;d%20like%20to%20ask%20about%20video%20editing." target="_blank" rel="noopener noreferrer" aria-label="Chat on WhatsApp" class="neo-button neo-button--primary neo-mobile-whatsapp-link w-full justify-center gap-2"><span class="material-symbols-outlined text-[19px]" aria-hidden="true">chat</span>WhatsApp</a></div></div><a class="neo-button neo-button--primary w-full uppercase tracking-[0.14em]" href="/signin?mode=signin&amp;redirectTo=%2Fdashboard" data-discover="true"><span class="material-symbols-outlined text-[19px]">login</span>Sign in</a></div></div></div><main data-analytics-region="page-content"><section id="faq-page" class="site-faq faq-page__section" aria-labelledby="_R_2kj5_"><div class="site-faq__intro"><p class="site-faq__kicker neo-section-label"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-question-mark" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><path d="M12 17h.01"></path></svg>FAQ</p><h1 class="site-faq__title" id="_R_2kj5_">Good questions.<br/>Straight answers.</h1><p class="site-faq__description">Explore practical answers about the editing process, pricing, footage, delivery, and keeping your work secure.</p><div class="faq-page__controls"><div class="faq-page__search"><label for="faq-search">Search questions and answers</label><div class="faq-page__search-field"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search" aria-hidden="true"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg><input id="faq-search" type="search" placeholder="Try “turnaround” or “4K”" value=""/></div></div><div class="faq-page__categories"><p>Browse by topic</p><div class="faq-page__category-list" role="group" aria-label="Filter FAQs by topic"><button type="button" aria-pressed="true">All</button><button type="button" aria-pressed="false">Workflow</button><button type="button" aria-pressed="false">Pricing</button><button type="button" aria-pressed="false">Footage</button><button type="button" aria-pressed="false">Thumbnails</button><button type="button" aria-pressed="false">Security</button></div></div></div></div><div class="site-faq__list"><article class="site-faq__item neo-card" data-open="false"><h2><button type="button" id="_R_bakj5_-question" class="site-faq__question" aria-expanded="false" aria-controls="_R_bakj5_-answer"><span>How does the raw footage handoff and editing process work?</span><span class="site-faq__arrow" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></button></h2><div id="_R_bakj5_-answer" class="site-faq__answer" role="region" aria-labelledby="_R_bakj5_-question" aria-hidden="true" inert=""><div class="site-faq__answer-inner"><p>After EdiCut confirms your project scope and billing, add a Google Drive, Dropbox, OneDrive, or Frame.io sharing link and your notes in the workspace. Set the link permissions for your editor in that storage service. First-cut timing is agreed with the team for each project.</p></div></div></article><article class="site-faq__item neo-card" data-open="false"><h2><button type="button" id="_R_jakj5_-question" class="site-faq__question" aria-expanded="false" aria-controls="_R_jakj5_-answer"><span>What is your turnaround time for first cuts and revisions?</span><span class="site-faq__arrow" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></button></h2><div id="_R_jakj5_-answer" class="site-faq__answer" role="region" aria-labelledby="_R_jakj5_-question" aria-hidden="true" inert=""><div class="site-faq__answer-inner"><p>Single-video packages have a 48-hour first-cut target after the brief, footage access, and payment are confirmed. We agree timing for larger or custom projects before editing starts. Send revision feedback as timestamped notes; revision timing depends on the agreed scope.</p></div></div></article><article class="site-faq__item neo-card" data-open="false"><h2><button type="button" id="_R_rakj5_-question" class="site-faq__question" aria-expanded="false" aria-controls="_R_rakj5_-answer"><span>How do I change or cancel a monthly editing plan?</span><span class="site-faq__arrow" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></button></h2><div id="_R_rakj5_-answer" class="site-faq__answer" role="region" aria-labelledby="_R_rakj5_-question" aria-hidden="true" inert=""><div class="site-faq__answer-inner"><p>The workspace records project requests and invoices but does not manage recurring charges. Contact EdiCut support to discuss changes or cancellation under your confirmed service agreement before the next billing cycle.</p></div></div></article><article class="site-faq__item neo-card" data-open="false"><h2><button type="button" id="_R_13akj5_-question" class="site-faq__question" aria-expanded="false" aria-controls="_R_13akj5_-answer"><span>Can I pay with cryptocurrency, a card, Apple Pay, or Google Pay?</span><span class="site-faq__arrow" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></button></h2><div id="_R_13akj5_-answer" class="site-faq__answer" role="region" aria-labelledby="_R_13akj5_-question" aria-hidden="true" inert=""><div class="site-faq__answer-inner"><p>EdiCut checkout uses Cryptomus for cryptocurrency payments. Choose a supported coin and network on the hosted payment page, check the amount and network carefully, and pay before the invoice expires. Credit cards, debit cards, Apple Pay, and Google Pay are not currently offered at EdiCut checkout.</p></div></div></article><article class="site-faq__item neo-card" data-open="false"><h2><button type="button" id="_R_1bakj5_-question" class="site-faq__question" aria-expanded="false" aria-controls="_R_1bakj5_-answer"><span>What happens if my video is longer than the included package limit?</span><span class="site-faq__arrow" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></button></h2><div id="_R_1bakj5_-answer" class="site-faq__answer" role="region" aria-labelledby="_R_1bakj5_-question" aria-hidden="true" inert=""><div class="site-faq__answer-inner"><p>Single-video packages list finished-length and raw-footage limits and revision rounds. Monthly packages reserve editing hours. Work outside those allowances is quoted before editing begins. A custom thumbnail or an additional short-form video is available as a $20 add-on with any package.</p></div></div></article><article class="site-faq__item neo-card" data-open="false"><h2><button type="button" id="_R_1jakj5_-question" class="site-faq__question" aria-expanded="false" aria-controls="_R_1jakj5_-answer"><span>What video formats and resolutions do you support?</span><span class="site-faq__arrow" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></button></h2><div id="_R_1jakj5_-answer" class="site-faq__answer" role="region" aria-labelledby="_R_1jakj5_-question" aria-hidden="true" inert=""><div class="site-faq__answer-inner"><p>We support 1080p, 4K, ProRes, MP4, MOV, Sony S-Log, Canon C-Log, D-Log, and multi-track audio. All exports are mastered at highest quality with proper bitrate and audio normalization for YouTube.</p></div></div></article><article class="site-faq__item neo-card" data-open="false"><h2><button type="button" id="_R_1rakj5_-question" class="site-faq__question" aria-expanded="false" aria-controls="_R_1rakj5_-answer"><span>Are custom YouTube thumbnails included in the packages?</span><span class="site-faq__arrow" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></button></h2><div id="_R_1rakj5_-answer" class="site-faq__answer" role="region" aria-labelledby="_R_1rakj5_-question" aria-hidden="true" inert=""><div class="site-faq__answer-inner"><p>Custom thumbnails are optional with every package: add one for $20 when choosing your plan. Thumbnails are not included in the base package price. Additional concepts or A/B thumbnail sets can be quoted separately.</p></div></div></article><article class="site-faq__item neo-card" data-open="false"><h2><button type="button" id="_R_23akj5_-question" class="site-faq__question" aria-expanded="false" aria-controls="_R_23akj5_-answer"><span>How secure is my unreleased footage and intellectual property?</span><span class="site-faq__arrow" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></span></button></h2><div id="_R_23akj5_-answer" class="site-faq__answer" role="region" aria-labelledby="_R_23akj5_-question" aria-hidden="true" inert=""><div class="site-faq__answer-inner"><p>Your workspace stores the sharing links and project details you submit. Keep source footage in your own storage provider and set its sharing permissions for your editor. Avoid public links for unreleased media; ask support about approved transfer options if you need a different workflow.</p></div></div></article></div></section><section data-analytics-region="faq" class="faq-page__support" aria-labelledby="faq-support-title"><div class="faq-page__support-panel neo-surface"><div class="faq-page__support-copy"><span class="faq-page__support-icon neo-icon-badge" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-circle" aria-hidden="true"><path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"></path></svg></span><div><h2 id="faq-support-title">Still have a specific question?</h2><p>Talk with our team about your editing workflow, turnaround, or a custom quote.</p></div></div><div class="faq-page__support-actions"><a class="neo-button neo-button--primary" href="/contact" data-discover="true">Chat with us</a><a class="neo-button neo-button--secondary" href="/pricing" data-discover="true">View pricing</a></div></div></section><section class="neo-trust-strip border-b neo-line px-5 py-8 sm:px-6"><div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-5 sm:flex-row"><p class="yt-tag neo-section-label"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-badge-check" aria-hidden="true"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"></path><path d="m9 12 2 2 4-4"></path></svg>A clear process for your next upload</p><div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3 yt-small font-bold neo-muted"><span>Defined editing scope</span><span>Timestamped feedback</span><span>Final export approval</span></div></div></section></main><footer data-analytics-region="footer" class="neo-footer relative overflow-hidden border-t px-4 sm:px-6"><div class="neo-footer__inner mx-auto max-w-7xl pb-5 pt-8 sm:pb-7 sm:pt-12 md:pb-10 md:pt-14"><div class="grid gap-4 md:grid-cols-[minmax(18rem,1.45fr)_minmax(9rem,1fr)_minmax(11rem,1fr)] md:items-stretch"><section class="neo-footer__lead flex flex-col justify-between p-5 md:p-6"><div><h2 class="type-card-title neo-footer-ink">Plan your next video</h2><p class="mt-2 max-w-md text-sm leading-5 neo-footer-muted sm:text-[15px]">Tell us your video format, footage, and deadline. We will help you choose an editing package.</p></div><a class="neo-button neo-button--dark neo-button--compact mt-6 w-fit" href="/contact" data-discover="true">Discuss your project</a></section><section class="neo-footer__group"><button type="button" aria-expanded="false" class="flex w-full items-center justify-between text-left text-sm font-bold neo-footer-ink md:pointer-events-none md:border-b md:border-[var(--neo-line)] md:pb-3">Explore<span class="footer-mobile-chevron material-symbols-outlined text-[20px] transition-transform duration-200">expand_more</span></button><nav class="grid gap-2 overflow-hidden text-sm transition-[max-height,opacity,padding] duration-200 max-h-0 opacity-0 md:mt-3 md:max-h-none md:overflow-visible md:pb-0 md:opacity-100" aria-label="Explore"><a class="neo-footer-link transition-colors" href="/why-hire-us" data-discover="true">Why Hire Us</a><a class="neo-footer-link transition-colors" href="/services" data-discover="true">Services</a><a class="neo-footer-link transition-colors" href="/pricing" data-discover="true">Pricing</a><a class="neo-footer-link transition-colors" href="/portfolio" data-discover="true">Portfolio</a></nav></section><section class="neo-footer__group"><button type="button" aria-expanded="false" class="flex w-full items-center justify-between text-left text-sm font-bold neo-footer-ink md:pointer-events-none md:border-b md:border-[var(--neo-line)] md:pb-3">Support<span class="footer-mobile-chevron material-symbols-outlined text-[20px] transition-transform duration-200">expand_more</span></button><nav class="grid gap-2 overflow-hidden text-sm transition-[max-height,opacity,padding] duration-200 max-h-0 