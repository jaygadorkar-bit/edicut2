/* /app/styles/editing-artwork.css */
.editing-artwork { display: block; width: 100%; height: auto; overflow: visible; }
.editing-artwork__halo { fill: #e3ebf2; }
.editing-artwork__surface { fill: var(--neo-surface-strong, #f4f7fa); stroke: white; stroke-width: 1.5; }
.editing-artwork__inset { fill: #dce5ed; }
.editing-artwork__slate { fill: #8fa5b8; }
.editing-artwork__slate-light { fill: #b7c8d5; }
.editing-artwork__rose { fill: #e7cbd1; }
.editing-artwork__accent { fill: #df2940; }
.editing-artwork__scene--city, .editing-artwork__scene--audio { opacity: 0; }
.editing-artwork__raised { filter: drop-shadow(4px 7px 6px rgb(132 148 163 / 24%)); }
.editing-artwork__line, .editing-artwork__accent-line, .editing-artwork__white-line { stroke: #536779; stroke-width: 2.8; stroke-linecap: round; stroke-linejoin: round; }
.editing-artwork__accent-line { stroke: #c52237; }
.editing-artwork__white-line { stroke: white; }
.editing-artwork__float { translate: 0 0; transition: translate 300ms ease; }
:is(.pack-workflow-steps li, .pack-final):hover .editing-artwork__float { translate: 0 -4px; }
@media (prefers-reduced-motion: reduce) {
  .editing-artwork__float { transition: none; translate: none !important; }
}


/* /app/styles/package-choice.css */
.package-choice-link { gap: .65rem; }
.package-choice-link__text { display: inline-block; }
.package-choice-link.is-noticed .package-choice-link__text { animation: package-choice-notice 1.7s ease-in-out 2; animation-delay: inherit; }
.package-choice-link > svg { transition: transform 200ms ease; }
.package-choice-link:is(:hover, :focus-visible) > svg { transform: translateX(3px); }
@keyframes package-choice-notice {
  0%, 65%, 100% { transform: translateY(0); }
  42% { transform: translateY(-2px); }
}
@media (prefers-reduced-motion: reduce) {
  .package-choice-link.is-noticed .package-choice-link__text { animation: none; }
  .package-choice-link > svg { transition: none; transform: none !important; }
}
@media (forced-colors: active) {
  .package-choice-link.is-noticed .package-choice-link__text { animation: none; }
}
