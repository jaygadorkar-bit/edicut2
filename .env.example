# Supabase browser build variables. Use the hosted project URL and publishable
# key; never expose SUPABASE_SERVICE_ROLE_KEY or CLOUDINARY_API_SECRET to clients.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<copy the publishable key from your Supabase project settings>

# Supabase/Cloudflare Worker runtime variables and secrets.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<copy the publishable key from your Supabase project settings>
SUPABASE_SERVICE_ROLE_KEY=<copy the service role key from your Supabase project settings>
# Optional: scoped Supabase PAT with analytics_usage_read for request counts; keep server-side only.
SUPABASE_PROJECT_REF=<supabase-project-ref>
SUPABASE_ACCESS_TOKEN=<scoped-supabase-personal-access-token>
SUPABASE_AUTH_ENABLED=true
# Hosted Supabase database URL for local Node and Cloudflare Worker development.
# Use the Supavisor session pooler on port 5432 with SSL. Keep the password secret.
SUPABASE_DATABASE_URL="postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Optional provider usage metrics. Keep tokens server-side.
# Cloudflare needs Zone:Read, Zone Analytics:Read, and Account Analytics:Read.
CLOUDFLARE_API_TOKEN=<cloudflare-analytics-read-token>
CLOUDFLARE_ACCOUNT_ID=<cloudflare-account-id>
CLOUDFLARE_ZONE_ID=<edicut-com-zone-id>
CLOUDFLARE_ZONE_NAME=edicut.com
CLOUDFLARE_WORKER_NAME=edicut-web

# Use `wrangler secret put` for these in Cloudflare.
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

# Dedicated Cloudinary account for portfolio videos.
CLOUDINARY_VIDEO_CLOUD_NAME=<cloudinary-video-cloud-name>
CLOUDINARY_VIDEO_API_KEY=<cloudinary-video-api-key>
CLOUDINARY_VIDEO_API_SECRET=<cloudinary-video-api-secret>

# Application/runtime.
APP_ENV=development
APP_URL=http://localhost:3002
NODE_API_BASE_URL=http://127.0.0.1:8787/api/node
DEBUG_MODE=true
SESSION_SECRET=replace-with-a-long-random-secret

# Cryptomus merchant API. Keep the payment key server-side; use Wrangler secrets in production.
CRYPTOMUS_MERCHANT_ID=<cryptomus-merchant-uuid>
CRYPTOMUS_PAYMENT_API_KEY=<cryptomus-payment-api-key>
# Test callbacks are disabled by default. Use only a public HTTPS development/staging URL.
CRYPTOMUS_TEST_WEBHOOK_ENABLED=false
CRYPTOMUS_TEST_WEBHOOK_CALLBACK_URL=https://staging.example.com/api/cryptomus/test-webhook

# Legacy compatibility. Existing local flows may still use these until all
# accounts have been moved to Supabase Auth.
AUTH_SECRET="changeme"
AUTH_URL="http://localhost:3002"
AUTH_GOOGLE_REDIRECT_URI=http://localhost:3002/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional dedicated studio OAuth client (keeps video storage separate from sign-in).
# Register both local and live callbacks for /api/auth/callback/youtube and
# /api/auth/callback/drive on the same Google web client. Drive requests the
# narrow drive.file scope for files EdiCut creates; YouTube retains its scopes.
YOUTUBE_OAUTH_CLIENT_ID=""
YOUTUBE_OAUTH_CLIENT_SECRET=""
GOOGLE_DRIVE_ACCOUNT_EMAIL=""
# Generate a random secret of at least 32 characters. Keep the SAME value on all
# app instances sharing the review database; rotating it invalidates saved tokens.
YOUTUBE_TOKEN_SECRET=""

# Gmail API (transactional app email).
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_SENDER_EMAIL=""
GMAIL_ACCESS_TOKEN=""

# Optional Telegram notifications for new unpaid subscription orders.
# In production, configure both as Wrangler secrets; do not commit real values.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Gmail SMTP-compatible OAuth settings (the Cloudflare Worker uses Gmail REST API transport).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_AUTH_TYPE="OAuth2"
SMTP_CLIENT_ID=""
SMTP_CLIENT_SECRET=""
SMTP_REFRESH_TOKEN=""
SMTP_ACCESS_TOKEN=""

# Optional integrations retained by existing routes.
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
RESEND_API_KEY=""
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Admin bootstrap for the local seed script.
ADMIN_BOOTSTRAP_EMAIL="admin@edicut.com"
ADMIN_BOOTSTRAP_PASSWORD="change-this-long-admin-password"
ADMIN_BOOTSTRAP_NAME="EdiCut Admin"
