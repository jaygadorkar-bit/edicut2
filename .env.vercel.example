# Vercel-facing runtime values for API and heavy workloads.
# Use this file as the baseline for the Vercel deployment target.

HYBRID_RUNTIME_TARGET="vercel"
NEXT_PUBLIC_API_BASE_URL="https://api.edicut.com"

# Keep secrets and service credentials in the Vercel project, not Cloudflare.
NEXT_PUBLIC_APP_URL="https://edicut.com"
AUTH_URL="https://edicut.com/api/auth"
