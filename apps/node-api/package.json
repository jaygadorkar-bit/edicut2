    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@hono/node-server": "^1.13.8",
    "@types/node": "^20.17.6",
    "@types/react": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
