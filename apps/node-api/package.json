{
  "name": "@edicut/node-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "pnpm --filter @edicut/shared build && pnpm --filter @edicut/db build && pnpm exec tsc --noEmit",
    "typecheck": "pnpm exec tsc --noEmit"
  },
  "dependencies": {
    "@edicut/db": "workspace:*",
    "@edicut/shared": "workspace:*",
    "@hono/zod-validator": "^0.9.1",
