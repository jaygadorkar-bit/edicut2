{
  "name": "@edicut/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @edicut/shared build && pnpm --filter @edicut/db build && react-router dev --port 3000",
    "build": "pnpm --filter @edicut/shared build && pnpm --filter @edicut/db build && react-router build",
    "typecheck": "pnpm --filter @edicut/shared build && pnpm --filter @edicut/db build && react-router typegen && pnpm exec tsc --noEmit",
    "deploy": "wrangler deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv worker-configuration.d.ts"
  },
  "dependencies": {
    "@edicut/db": "workspace:*",
    "@edicut/platform-core": "workspace:*",
    "@edicut/shared": "workspace:*",
    "@tailwindcss/vite": "^4.2.4",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.36.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.8.0",
    "tailwindcss": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260426.1",
    "@react-router/cloudflare": "^7.8.0",
    "@react-router/dev": "^7.8.0",
    "@react-router/node": "^7.8.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "wrangler": "^4.86.0"
  }
}
