{
  "name": "@edicut/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @edicut/shared build && pnpm --filter @edicut/db build && react-router dev --port 3002",
    "build": "pnpm --filter @edicut/shared build && pnpm --filter @edicut/db build && react-router build",
    "typecheck": "pnpm --filter @edicut/shared build && pnpm --filter @edicut/db build && react-router typegen && pnpm exec tsc --noEmit",
    "deploy": "wrangler deploy --profile edicut-production",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv worker-configuration.d.ts"
  },
  "dependencies": {
    "@edicut/db": "workspace:*",
    "@edicut/platform-core": "workspace:*",
    "@edicut/shared": "workspace:*",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.2.4",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.3",
    "lenis": "^1.3.26",
    "lucide-react": "^1.33.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.3",
    "tailwindcss": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@react-router/cloudflare": "^7.18.3",
    "@react-router/dev": "^7.18.3",
    "@react-router/node": "^7.18.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^5.1.4",
    "wrangler": "^4.146.0"
  }
}
