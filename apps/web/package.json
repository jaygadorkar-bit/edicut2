{
  "name": "@edicut/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @edicut/shared build && pnpm --filter @edicut/db build && react-router dev --port 3002",
    "build": "pnpm --filter @edicut/shared build && pnpm --filter @edicut/db build && react-router build",
    "build:cloudflare": "pnpm --filter @edicut/shared build && pnpm --filter @edicut/db build && node ./scripts/build-cloudflare.mjs",
    "typecheck": "pnpm --filter @edicut/shared build && pnpm --filter @edicut/db build && react-router typegen && pnpm exec tsc --noEmit",
    "deploy": "pnpm run build:cloudflare && wrangler deploy --profile edicut-production",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv worker-configuration.d.ts"
  },
  "dependencies": {
    "@edicut/db": "workspace:*",
    "@edicut/platform-core": "workspace:*",
    "@edicut/shared": "workspace:*",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.5",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "lenis": "^1.3.27",
    "lucide-react": "^1.70.0",
    "mediabunny": "1.65.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@react-router/cloudflare": "^8.5.1",
    "@react-router/dev": "^8.5.1",
    "@react-router/node": "^8.5.1",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0",
    "ws": "^8.22.1"
  }
}
