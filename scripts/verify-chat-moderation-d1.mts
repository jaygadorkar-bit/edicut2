// Disposable local workerd only; no environment credentials or remote writes.
import assert from "node:assert/strict";
import { readFile } from "node:fs/promises";
import { createRequire } from "node:module";
import { createD1ChatStore } from "../apps/web/app/lib/chat-d1.server";
import type { ChatAuthority } from "../apps/web/app/lib/chat-authority.server";
import type { ChatActor } from "../apps/web/app/lib/chat";
const web=createRequire(new URL("../apps/web/package.json",import.meta.url)),runtime=createRequire(web.resolve("wrangler"));
const {Miniflare,convertV4MiniflareOptions}=runtime("miniflare");
const app=new Miniflare(convertV4MiniflareOptions({name:"chat-moderation-local",modules:true,compatibilityDate:"2026-04-19",script:"export default {fetch(){return new Response('Local verification only',{status:404})}}",d1Databases:{CHAT_D1:"chat-moderation-local"}}));
const id=()=>crypto.randomUUID(),clientId=id(),otherId=id(),adminId=id();
const source:ChatAuthority={users:[clientId,otherId].map((id,index)=>({id,email:`fixture${index}@example.test`,name:`Client ${index}`,role:"customer",active:true,deletedAt:null,paid:true})),admins:[{id:adminId,email:"admin@example.test",name:"Admin",role:"admin",active:true}]};
const client:ChatActor={id:clientId,key:`user:${clientId}`,role:"customer",admin:false,name:"Client"};
const other:ChatActor={...client,id:otherId,key:`user:${otherId}`};
const admin:ChatActor={id:adminId,key:`admin:${adminId}`,role:"admin",admin:true,name:"Admin"};
let checks=0;const check=(value:unknown,label:string)=>{assert.ok(value,label);checks++;};
const denied=async(run:()=>Promise<unknown>,status:number)=>{await assert.rejects(run,error=>error instanceof Response&&error.status===status);checks++;};
try{
 const db=await app.getD1Database("CHAT_D1") as D1Database;
 const statements=(await Promise.all(["0001_chat.sql","0002_chat_search.sql","0003_chat_room_search.sql"].map(name=>readFile(new URL(`../packages/db/d1/chat/${name}`,import.meta.url),"utf8")))).join("\n").split("\n").filter(line=>!line.trim().startsWith("--")).join(" ").split(";").map(s=>s.trim()).filter(Boolean);
 await db.batch(statements.map(statement=>db.prepare(statement)));
 const store=createD1ChatStore(db,async()=>structuredClone(source));
 await store.ensureClientChatRooms(admin);
 const project=(await store.listChatRooms(client)).rooms[0];
 const otherProject=(await store.listChatRooms(other)).rooms[0];
 const attachment={publicId:"moderation-only-fixture",name:"moderation-only-fixture.pdf",mime:"application/pdf",bytes:123};
 const before=await store.getClientLegacyChatAttachmentBytes(clientId);
 const mixed=await store.sendChatMessage(client,project.id,"Preserve this explanation",id(),attachment);
 await denied(()=>store.removeChatAttachment(client,project.id,mixed.id),403);
 await denied(()=>store.changeChatMessage(other,project.id,mixed.id,null),403);
 await denied(()=>store.changeChatMessage(admin,project.id,mixed.id,"Not my text"),403);
 await denied(()=>store.removeChatAttachment(admin,otherProject.id,mixed.id),404);
 const removed=await store.removeChatAttachment(admin,project.id,mixed.id);
 check(removed.message.body==="Preserve this explanation"&&removed.message.attachment===null&&!removed.message.deletedAt,"Attachment-only moderation preserves text");
 check(removed.attachment.publicId===attachment.publicId,"Cleanup gets original metadata");
 await denied(()=>store.getChatAttachment(client,project.id,mixed.id),404);
 check(!(await store.listChatMessages(client,project.id,undefined,attachment.name)).messages.length,"Removed filenames are excluded from search");
 check((await store.listChatMessages(client,project.id)).messages.find(m=>m.id===mixed.id)?.attachment===null,"Removed file metadata stays out of history");
 check((await store.getClientLegacyChatAttachmentBytes(clientId))===before+123,"Unconfirmed storage cleanup remains charged");
 check((await store.removeChatAttachment(admin,project.id,mixed.id)).message.attachment===null,"Retry cannot restore a removed file");
 await store.finishChatAttachmentCleanup(project.id,mixed.id,{...attachment,publicId:"wrong-file"});
 check((await store.getClientLegacyChatAttachmentBytes(clientId))===before+123,"Cleanup is restricted to the exact file");
 await store.finishChatAttachmentCleanup(project.id,mixed.id,attachment);
 check((await store.getClientLegacyChatAttachmentBytes(clientId))===before,"Confirmed cleanup releases legacy quota");
 const only=await store.sendChatMessage(client,project.id,"",id(),attachment);
 check(Boolean((await store.removeChatAttachment(admin,project.id,only.id)).message.deletedAt),"File-only removal leaves a deletion marker");
 const full=await store.sendChatMessage(client,project.id,"Delete for everyone",id(),attachment);
 const deleted=await store.changeChatMessage(admin,project.id,full.id,null);
 check(Boolean(deleted.deletedAt)&&deleted.actorKey===client.key&&deleted.body==="","Admin deletes another author's message without changing attribution");
 check((await store.listChatMessages(client,project.id)).messages.find(m=>m.id===full.id)?.attachment===null,"Deleted message metadata is not exposed");
 await denied(()=>store.getChatAttachment(admin,project.id,full.id),404);
 const system=id();
 await db.prepare("INSERT INTO chat_messages(id,room_id,actor_key,sender_name,sender_role,body,client_nonce,created_at,search_body) VALUES(?,?,'system:assignment','Activity','system','Protected notice',?,?,'protected notice')").bind(system,project.id,system,new Date().toISOString()).run();
 await denied(()=>store.changeChatMessage(admin,project.id,system,null),403);
 const ticket=id();
 await store.createSupportTicket(client,ticket,"Moderation fixture","technical","normal","Keep this request");
 const ticketFile=await store.sendChatMessage(client,ticket,"Keep ticket text",id(),attachment);
 const opened=await store.getChatRoom(admin,ticket);
 await store.updateSupportTicket(admin,ticket,"closed","normal",opened.ticket!.updatedAt);
 check((await store.removeChatAttachment(admin,ticket,ticketFile.id)).message.body==="Keep ticket text","Closed-ticket file moderation works");
 check(Boolean((await store.changeChatMessage(admin,ticket,ticketFile.id,null)).deletedAt),"Closed-ticket message deletion works");
 source.admins[0].active=false;
 await denied(()=>store.removeChatAttachment(admin,project.id,only.id),403);
 check(!(await db.prepare("PRAGMA foreign_key_check").all()).results.length,"Foreign keys remain intact");
 console.log(`${checks} D1 moderation checks passed against disposable local workerd fixtures.`);
}catch(error){if(error instanceof Response)console.error("Moderation check rejected:",error.status,await error.clone().text());throw error;}
finally{await app.dispose();}
